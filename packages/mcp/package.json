{
  "name": "@makitaki/text-barrier-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.mcontrerasmalpar-pixel/text-barrier-mcp",
  "description": "MCP server for Text Barrier Detector: deterministic readability scores, CEFR-inspired Readability Band (A1–C2), and sentence/word barrier detection for English and Spanish.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "readability",
    "plain-language",
    "accessibility",
    "flesch",
    "fernandez-huerta",
    "spanish",
    "english"
  ],
  "license": "MIT",
  "author": "Maria Contreras",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcontrerasmalpar-pixel/text-barrier-detector.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/mcontrerasmalpar-pixel/text-barrier-detector/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/mcontrerasmalpar-pixel/text-barrier-detector/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "text-barrier-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@makitaki/text-barrier-core": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  }
}
